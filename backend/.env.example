# Google Cloud Console에서 만든 OAuth 웹 클라이언트 ID
GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# 32바이트 이상의 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
# 쉼표로 구분한 프론트엔드 주소
CORS_ALLOWED_ORIGINS=https://sat7312.github.io,http://localhost:5173
# 배포 DB (없으면 로컬 H2 파일 DB를 사용)
SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/spendlog?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
